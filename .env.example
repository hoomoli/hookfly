# Credentials are injected by the runtime environment and referenced by the complete v2 example.
DOKPLOY_API_KEY=
APPLICATION_ADMIN_TOKEN=
GITLAB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Hookfly runtime defaults. Change these only when your layout or bindings differ.
HOOKFLY_CONFIG=hookfly.yaml
HOOKFLY_DB=hookfly.db
HOOKFLY_PUBLIC_ADDR=:8080
HOOKFLY_ADMIN_ADDR=:8081

# Management authentication defaults to OIDC and fails closed when these values are missing.
HOOKFLY_AUTH_MODE=oidc
HOOKFLY_EXTERNAL_URL=https://webhook.chuandashow.com
AUTHENTIK_ISSUER=https://authentik.example.invalid/application/o/hookfly/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_OAUTH_SCOPES=openid,profile
HOOKFLY_AUTH_DISPLAY_CLAIM=preferred_username
HOOKFLY_AUTH_ALLOWED_GROUPS=hookfly-users
# Generate with: openssl rand -base64 32
HOOKFLY_AUTH_SESSION_SECRET=

# Compose example routing. The Traefik network must already exist.
# Relative host paths are resolved from deploy/compose.example.yaml.
HOOKFLY_CONFIG_DIR=../configs
HOOKFLY_ROUTE_HOST=webhook.chuandashow.com
HOOKFLY_HTTPS_ENTRYPOINT=websecure
HOOKFLY_CERT_RESOLVER=letsencrypt
HOOKFLY_ROUTER_PRIORITY=1
HOOKFLY_HOOKS_ROUTER_PRIORITY=100
HOOKFLY_PROXY_NETWORK=dokploy-network
