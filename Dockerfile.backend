FROM golang:1.26-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY migrations ./migrations
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/hookfly ./cmd/hookfly && \
    mkdir -p /out/data && \
    printf 'hookfly:x:65532:65532:Hookfly:/var/lib/hookfly:/sbin/nologin\n' > /out/passwd && \
    printf 'hookfly:x:65532:\n' > /out/group

FROM scratch

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/passwd /etc/passwd
COPY --from=build /out/group /etc/group
COPY --from=build --chown=65532:65532 /out/data /var/lib/hookfly
COPY --from=build /out/hookfly /hookfly

WORKDIR /var/lib/hookfly
USER 65532:65532
VOLUME ["/var/lib/hookfly"]
EXPOSE 8080 8081
HEALTHCHECK --interval=10s --timeout=6s --start-period=5s --retries=3 \
  CMD ["/hookfly", "healthcheck", "--url", "http://127.0.0.1:8081/api/v1/health"]
ENTRYPOINT ["/hookfly"]
